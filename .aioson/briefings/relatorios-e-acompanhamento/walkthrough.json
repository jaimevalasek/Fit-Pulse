{
  "name": "prototype-relatorios-e-acompanhamento",
  "feature": "relatorios-e-acompanhamento",
  "file": ".aioson/briefings/relatorios-e-acompanhamento/prototype.html",
  "scope": "prototype",
  "viewport": { "width": 1280, "height": 860 },
  "timeout": 8000,
  "steps": [
    { "do": "goto", "url": "#/empresa/c1/relatorios" },
    { "do": "expect", "visible": "css=.tour-pop", "ac": "PROM-002", "note": "tour de primeiro uso explica as telas novas em linguagem leiga" },
    { "do": "expect", "text": "Relatórios em PDF", "target": "css=.tour-pop", "ac": "PROM-001" },
    { "do": "click", "target": "role=button[name=\"Pular\"]" },
    { "do": "expect", "hidden": "css=.tour-pop" },

    { "do": "expect", "visible": "css=[data-aioson-primary]", "ac": ["PROM-001", "PROM-004"], "note": "a prévia em papel é o foco da central de relatórios" },
    { "do": "expect", "count": 5, "target": "css=.pages .paper", "ac": ["PROM-002", "PROM-004"], "note": "capa, resumo executivo, 8 dimensões, riscos e como ler" },
    { "do": "expect", "visible": "css=.paper[aria-label*=\"Resumo executivo\"]", "ac": ["PROM-002", "PROM-004"] },
    { "do": "expect", "visible": "css=.matrix", "ac": ["PROM-002", "PROM-004"], "note": "matriz de riscos 5×5 desenhada" },
    { "do": "check", "target": "css=[data-change=\"rep-answers\"]", "ac": "PROM-004", "note": "apêndice com as respostas, desligado por padrão" },
    { "do": "expect", "count": 6, "target": "css=.pages .paper", "ac": "PROM-004" },
    { "do": "expect", "visible": "css=.paper[aria-label*=\"Respostas do questionário\"]", "ac": "PROM-004" },

    { "do": "click", "target": "css=[data-aioson-id=\"report-export\"]", "ac": "PROM-001" },
    { "do": "expect", "text": "padaria-trigo-bom-2026-08-27.pdf", "target": "css=.dialog", "ac": "PROM-001" },
    { "do": "click", "target": "css=[data-aioson-id=\"export-confirm\"]", "ac": "PROM-001" },
    { "do": "expect", "visible": "css=[data-aioson-id=\"export-saved\"]", "ac": "PROM-001", "note": "salvo na pasta Downloads" },
    { "do": "expect", "visible": "css=[data-aioson-id=\"open-pdf\"]", "ac": ["PROM-001", "PROM-004"], "note": "Abrir PDF depois de salvar" },
    { "do": "expect", "visible": "css=[data-aioson-id=\"show-folder\"]", "ac": ["PROM-001", "PROM-004"] },
    { "do": "click", "target": "css=[data-aioson-id=\"open-pdf\"]" },
    { "do": "expect", "text": "PDF salvo em Downloads", "target": "css=[data-aioson-id=\"export-notice\"]", "ac": "PROM-001", "note": "o resultado da exportação fica visível depois que o diálogo fecha" },

    { "do": "click", "target": "css=[data-aioson-id=\"type-evo\"]", "ac": "PROM-004" },
    { "do": "expect", "visible": "css=.paper[aria-label*=\"Antes e depois\"]", "ac": "PROM-004", "note": "relatório de evolução" },
    { "do": "expect", "text": "1 → 2", "target": "css=.paper[aria-label*=\"Antes e depois\"]", "ac": "PROM-004" },

    { "do": "goto", "url": "#/empresa/c1/relatorios?state=error" },
    { "do": "expect", "visible": "css=.dialog [role=\"alert\"]", "ac": "PROM-001", "note": "falha de gravação explica e não altera nada" },
    { "do": "click", "target": "role=button[name=\"Tentar de novo\"]" },
    { "do": "expect", "visible": "css=[data-aioson-id=\"export-saved\"]", "ac": "PROM-001" },
    { "do": "press", "key": "Escape" },

    { "do": "goto", "url": "#/empresa/c3/relatorios" },
    { "do": "expect", "visible": "css=[data-aioson-id=\"reports-empty\"]", "ac": "PROM-004", "note": "sem diagnóstico concluído não há relatório" },

    { "do": "goto", "url": "#/configuracoes" },
    { "do": "fill", "target": "css=#b-email", "value": "marina@" },
    { "do": "click", "target": "css=[data-aioson-id=\"brand-save\"]" },
    { "do": "expect", "visible": "css=#b-email[aria-invalid=\"true\"]", "ac": "PROM-008", "note": "e-mail inválido recusado no campo" },
    { "do": "click", "target": "role=button[name=\"Simular arquivo SVG\"]" },
    { "do": "expect", "text": "Use uma imagem PNG ou JPG", "target": "css=#e-logo", "ac": "PROM-008" },
    { "do": "click", "target": "role=button[name=\"Preencher com um exemplo\"]" },
    { "do": "click", "target": "css=[data-aioson-id=\"brand-save\"]", "ac": "PROM-008" },
    { "do": "expect", "text": "Rumo Consultoria", "target": "css=.cover-preview .cover-brand", "ac": "PROM-008", "note": "capa mostra a marca salva" },
    { "do": "goto", "url": "#/empresa/c1/relatorios" },
    { "do": "expect", "text": "Rumo Consultoria", "target": "css=.pages .paper >> nth=0", "ac": "PROM-008", "note": "nome de quem entrega na capa" },
    { "do": "expect", "text": "Rumo Consultoria", "target": "css=.pages .paper >> nth=1", "ac": "PROM-008", "note": "e no rodapé das páginas" },

    { "do": "goto", "url": "#/empresa/c1/acoes" },
    { "do": "expect", "text": "Continua do diagnóstico de 20/04/2026", "ac": ["PROM-005", "PROM-003"], "note": "a ação repetida herda o andamento (decisão F3)" },
    { "do": "expect", "text": "Vencida em 15/10/2026", "ac": "PROM-005" },
    { "do": "expect", "text": "faltam 32 dias", "target": "css=[data-aioson-id=\"reeval-line\"]", "ac": ["PROM-005", "PROM-003"] },
    { "do": "expect", "visible": "css=[data-aioson-id=\"closed-actions\"]", "ac": "PROM-005", "note": "ações não repetidas ficam encerradas" },
    { "do": "select", "target": "css=[data-aioson-id=\"status-d2-teste\"]", "value": "doing", "ac": "PROM-005" },
    { "do": "expect", "text": "agora está em andamento", "target": "css=.toasts", "ac": "PROM-005" },
    { "do": "click", "target": "css=[data-aioson-id=\"edit-d2-teste\"]", "ac": "PROM-005" },
    { "do": "fill", "target": "css=#a-due", "value": "31022026" },
    { "do": "click", "target": "css=#act-form button[type=submit]" },
    { "do": "expect", "text": "Data inválida", "target": "css=#e-due", "ac": "PROM-005" },
    { "do": "fill", "target": "css=#a-due", "value": "15112026" },
    { "do": "select", "target": "css=#a-role", "value": "Consultor", "ac": "PROM-005" },
    { "do": "click", "target": "css=#act-form button[type=submit]" },
    { "do": "expect", "text": "Prazo 15/11/2026", "target": "css=[data-aioson-id=\"action-d2-teste\"]", "ac": "PROM-005" },
    { "do": "expect", "text": "Consultor", "target": "css=[data-aioson-id=\"action-d2-teste\"]", "ac": "PROM-005" },

    { "do": "goto", "url": "#/empresa/c1/diario" },
    { "do": "expect", "text": "Custo por cliente medido", "ac": ["PROM-006", "PROM-003"], "note": "3 meses anotados contam como medido (decisão F4)" },
    { "do": "click", "target": "css=[data-aioson-id=\"add-month\"] >> nth=0", "ac": "PROM-006" },
    { "do": "fill", "target": "css=#m-month", "value": "092026" },
    { "do": "fill", "target": "css=#m-cust", "value": "30" },
    { "do": "fill", "target": "css=#m-ads", "value": "120000" },
    { "do": "click", "target": "css=[data-aioson-id=\"month-save\"]" },
    { "do": "expect", "text": "já está anotado", "target": "css=#e-month", "ac": "PROM-006", "note": "mês duplicado recusado" },
    { "do": "fill", "target": "css=#m-month", "value": "102026" },
    { "do": "click", "target": "css=[data-aioson-id=\"month-save\"]", "ac": "PROM-006" },
    { "do": "expect", "visible": "css=[data-aioson-id=\"month-2026-10\"]", "ac": "PROM-006" },
    { "do": "expect", "text": "R$ 40,00", "target": "css=[data-aioson-id=\"month-2026-10\"]", "ac": "PROM-006", "note": "o app calcula o custo por cliente do mês" },
    { "do": "click", "target": "css=[data-aioson-id=\"month-2026-10\"] [data-act=\"delete-month\"]", "ac": "PROM-006" },
    { "do": "expect", "visible": "role=dialog[name=/Excluir outubro de 2026/]", "ac": "PROM-006" },
    { "do": "click", "target": "role=button[name=\"Excluir mês\"]" },
    { "do": "expect", "hidden": "css=[data-aioson-id=\"month-2026-10\"]", "ac": "PROM-006" },
    { "do": "goto", "url": "#/empresa/c1/diario?state=empty" },
    { "do": "expect", "visible": "css=[data-aioson-id=\"diary-empty\"]", "ac": "PROM-006" },

    { "do": "goto", "url": "#/inicio" },
    { "do": "expect", "text": "Refazer o diagnóstico", "ac": ["PROM-005", "PROM-003"] },
    { "do": "expect", "visible": "css=[data-aioson-id=\"home-diary-widget\"]", "ac": ["PROM-006", "PROM-003"] },

    { "do": "click", "target": "css=[data-aioson-id=\"mode-toggle\"]" },
    { "do": "expect", "text": "Sua carteira", "ac": "PROM-004" },
    { "do": "click", "target": "css=[data-aioson-id=\"home-portfolio-report\"]", "ac": "PROM-004" },
    { "do": "expect", "visible": "css=.paper[aria-label*=\"Empresas por estágio\"]", "ac": "PROM-004", "note": "relatório da carteira" },

    { "do": "goto", "url": "#/empresa/c1" },
    { "do": "click", "target": "css=[data-aioson-id=\"send-questionnaire\"]", "ac": "PROM-007" },
    { "do": "expect", "text": "abre no navegador do computador", "target": "css=.dialog", "ac": "PROM-007", "note": "forma B: computador (decisão F1)" },
    { "do": "click", "target": "css=[data-aioson-id=\"send-generate\"]", "ac": "PROM-007" },
    { "do": "expect", "text": "questionario-padaria-trigo-bom.html", "target": "css=.dialog", "ac": "PROM-007" },
    { "do": "click", "target": "role=link[name=\"Ver como o cliente vê\"]" },
    { "do": "expect", "visible": "css=[data-aioson-id=\"desktop-note\"]", "ac": "PROM-007" },
    { "do": "fill", "target": "css=#cq-spend", "value": "315000" },
    { "do": "click", "target": "role=button[name=\"Próximo bloco\"]" },
    { "do": "click", "target": "css=.rail [data-i=\"7\"]" },
    { "do": "click", "target": "role=button[name=\"Revisar\"]" },
    { "do": "expect", "text": "Revise e salve", "ac": "PROM-007" },
    { "do": "click", "target": "css=[data-aioson-id=\"client-save\"]", "ac": "PROM-007" },
    { "do": "expect", "visible": "css=[data-aioson-id=\"client-saved\"]", "ac": "PROM-007", "note": "o cliente salva o arquivo de respostas" },

    { "do": "goto", "url": "#/empresa/c1" },
    { "do": "click", "target": "css=[data-aioson-id=\"import-answers\"]", "ac": "PROM-007" },
    { "do": "click", "target": "css=[data-act=\"import-pick\"][data-i=\"1\"]" },
    { "do": "expect", "text": "não de Padaria Trigo Bom", "target": "css=.dialog [role=\"alert\"]", "ac": "PROM-007", "note": "arquivo de outra empresa recusado sem alterar nada" },
    { "do": "click", "target": "role=button[name=\"Escolher outro arquivo\"]" },
    { "do": "click", "target": "css=[data-act=\"import-pick\"][data-i=\"0\"]", "ac": "PROM-007" },
    { "do": "expect", "text": "Rascunho criado", "target": "css=.dialog", "ac": "PROM-007" },
    { "do": "click", "target": "role=button[name=\"Fechar\"]" },
    { "do": "expect", "visible": "css=[data-aioson-id=\"imported-draft\"]", "ac": "PROM-007" },

    { "do": "eval", "expression": "!/\\bV[1-4]\\b|V4 Company|Método V4/.test(document.body.innerText) && !document.querySelector('input[type=password]')", "equals": true, "ac": "PROM-002", "note": "sem termos de terceiros nem login" }
  ]
}
